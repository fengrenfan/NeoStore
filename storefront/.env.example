# Copy to `.env.local` for local development. Everything here is read at build
# time for the NEXT_PUBLIC_* keys, so changing one means restarting `npm run dev`.

# Where *server components* reach the API. Inside compose this is the service
# name (`http://api:8000`); locally it is the port you run uvicorn on.
API_BASE_URL=http://127.0.0.1:8000

# Where the *browser* reaches the API. Must be a URL the visitor's machine can
# resolve — never an internal hostname.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Absolute base for canonical URLs, hreflang alternates, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must stay in sync with the `locale` table (see docs/RUNBOOK.md). Middleware
# runs on the edge, so it cannot ask the database per request.
NEXT_PUBLIC_LOCALES=zh-CN,en,ja
NEXT_PUBLIC_DEFAULT_LOCALE=zh-CN
