# --- NeoStore backend ---
ENV=local

# PostgreSQL 16
DATABASE_URL=postgresql+asyncpg://neostore:neostore@db:5432/neostore

# Redis 7
REDIS_URL=redis://redis:6379/0

# Auth — MUST be replaced in production
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=1440

# Open exchange rate API (adapter is swappable; failure keeps the last stored rate)
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_REFRESH_HOURS=6

# Defaults for locale / currency resolution
DEFAULT_LOCALE=zh-CN
DEFAULT_CURRENCY=USD

# Public origins allowed to call the API
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Seeded admin account (change before going live)
SEED_ADMIN_EMAIL=admin@neostore.local
SEED_ADMIN_PASSWORD=admin123
